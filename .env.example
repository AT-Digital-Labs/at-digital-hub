# Copy to .env.local for local work. Never commit real values.
# On Vercel, set these under Project Settings → Environment Variables (see README for per-environment guidance).

# ── Site identity ───────────────────────────────────────────────────────────────
# REQUIRED for Production. Canonical origin, no path, no trailing slash. A Production build fails without it.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Self-hosting only (not Vercel): set to "true" on the one production deployment that should be indexed.
# On Vercel, indexing is controlled by VERCEL_ENV=production automatically; leave this unset.
# ALLOW_INDEXING=true

# ── Contact form delivery (all three are required to enable the form) ────────────
# API key from https://resend.com (server-only; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# A sender on a domain you have verified with Resend. Plain address or "Name <address>".
CONTACT_FROM_EMAIL=AT Digital Hub <inquiries@your-verified-domain.example>
# Inbox(es) that receive inquiries. Comma-separated, up to 5. Visitor's email is set as Reply-To.
CONTACT_TO_EMAIL=you@your-domain.example

# ── Optional public details — each is rendered only when set ────────────────────
# Shown on the page as a direct contact option. Leave empty if you don't want to publish an address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Real destination for an "Explore Unexoro" button. No button is rendered when empty.
NEXT_PUBLIC_UNEXORO_URL=
# Social profiles (also added to Organization structured data) and policy pages. https only.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
